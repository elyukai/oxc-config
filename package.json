{
  "name": "@elyukai/oxc-config",
  "version": "0.1.4",
  "description": "Shared configuration for oxfmt and oxlint across projects",
  "license": "MPL-2.0",
  "author": "Lukas Obermann",
  "type": "module",
  "files": [
    "*.config.{js,d.ts}"
  ],
  "main": "index.js",
  "exports": {
    "./formatter": "./oxfmt.config.js",
    "./linter": "./oxlint.config.js"
  },
  "scripts": {
    "release": "commit-and-tag-version",
    "release:sign": "commit-and-tag-version --sign --signoff",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt \"{src,test}/**/*.{ts,tsx}\"",
    "format:check": "oxfmt \"{src,test}/**/*.{ts,tsx}\" --check"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "commit-and-tag-version": "^13.3.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "oxfmt": ">=0.76.0",
    "oxlint": ">=1.91.0"
  },
  "repository": "github:elyukai/oxc-config",
  "bugs": {
    "url": "https://github.com/elyukai/oxc-config/issues"
  }
}
